# Normalize everything to LF in the repository, and check it out as LF on every
# platform.
* text=auto eol=lf

# The FLDigi utility script
utilities/fltools text eol=lf

# Python sources
*.py text diff=python

# Config and data files that must stay LF.
*.toml          text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.md            text eol=lf diff=markdown
.example_env    text eol=lf
.python-version text eol=lf
LICENSE         text eol=lf

# Binary. Never normalize, never try to diff.
*.png binary
*.jpg binary
*.ico binary

# Generated by uv
uv.lock linguist-generated=true

# Keep development scaffolding out of `git archive` tarballs, including the
# ones GitHub builds for a release tag. This does not affect `uv build`, which
# constructs its own sdist.
.gitattributes          export-ignore
.gitignore              export-ignore
.pre-commit-config.yaml export-ignore
.github/                export-ignore
