#!/usr/bin/env bash
#
# fltools - shim that runs the uv-managed `fltools` CLI from inside
# FLDigi's <EXEC> macro child process.
#
# INSTALL
#   Save this file as ~/.fldigi/scripts/fltools and chmod +x it.
#   Fldigi prepends ~/.fldigi/scripts to PATH before running EXEC
#   children, so macros can just say:
#
#       <EXEC>fltools logqso</EXEC>
#
#   No absolute path needed, and it'll also show up as its own
#   entry in the macro browser's exec-script list.
#
# WHY THIS EXISTS
#   The <EXEC> child does NOT get a login/interactive shell - it does
#   not source .bashrc/.profile - so `uv` may not be on PATH even
#   though it works fine in your terminal. This script hunts for it.
#   It also keeps stdout untouched: fldigi captures the child's
#   stdout and appends it to the TX buffer (re-parsing it for macro
#   tags), so anything a subcommand prints on stdout is what gets
#   sent over the air. stderr is redirected to a log file instead,
#   so uv noise / Python tracebacks never end up on the air.
#
# FLDIGI_* ENV VARS
#   Fldigi exports FLDIGI_MY_CALL, FLDIGI_LOG_CALL, FLDIGI_FREQUENCY,
#   FLDIGI_LOG_LOCATOR, FLDIGI_MODEM, FLDIGI_PID, etc. into this
#   process already. They're inherited automatically by `uv run` and
#   the Python process below - nothing extra to do for that part.
#   Your Python code just reads os.environ["FLDIGI_..."].

set -o errexit # Exit on command failure
set -o nounset # Script fails on unset variable
set -o pipefail # Script fails on any command in a pipe failing

PROJECT_DIR=$HOME/source/fltools

LOG_FILE=$HOME/source/fltoolss/logs/fltools.err.log

UV_BIN=/opt/homebrew/bin/uv

mkdir -p "$(dirname "$LOG_FILE")"

# --no-sync skips uv's per-run "is the venv up to date" check, which
# keeps macro-button response snappy mid-QSO. Run `uv sync --project
# "$PROJECT_DIR"` by hand after you change dependencies. Drop --no-sync
# below while you're still actively developing the tool.
#
# `fltools` here is resolved as the console-script entry point defined
# in pyproject.toml's [project.scripts]. If you haven't wired that up
# yet, swap the last line for: "$UV_BIN" run --project "$PROJECT_DIR" \
#   --no-sync python -m fltools "$@" 2>>"$LOG_FILE"
exec "$UV_BIN" run --project "$PROJECT_DIR" --no-sync src/fltools.py "$@" 2>>"$LOG_FILE"
